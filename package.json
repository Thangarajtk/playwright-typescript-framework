{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Playwright framework for web application automation using typescript",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test-headed": "npx playwright test --headed",
    "test-ui": "npx playwright test --ui",
    "testOnWebkit": "npx playwright test --project webkit",
    "show-report": "npx playwright show-report",
    "testWithTraceViewer": "npx playwright test --trace on",
    "debugtest": "npx playwright test --debug",
    "test-mobile": "npx playwright test -c playwright.mobile.config.ts",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "test-web-tags": "npx playwright test --headed --grep @web",
    "testWithAllureReport": "npx playwright test --headed --grep @web --reporter=line,allure-playwright",
    "generatereport": "allure generate --single-file ./allure-results -o ./allure-report --clean && allure open ./allure-report"
  },
  "keywords": [],
  "author": "Thangaraj",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "exceljs": "^4.4.0",
    "npm-check-updates": "^23.1.0"
  }
}
